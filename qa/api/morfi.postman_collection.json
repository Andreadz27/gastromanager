			"name": "01 · Salud y carta pública",
			"description": "Lo que se ve sin iniciar sesión.",
			"item": [
				{
					"name": "Salud del servidor",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/salud",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"salud"
							]
						},
						"description": "",
						"auth": {
							"type": "noauth"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 y ok', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().ok).to.eql(true); });",
									"pm.test('la base responde', () => pm.expect(pm.response.json().base).to.eql('ok'));"
								]
							}
						}
					]
				},
				{
					"name": "Carta pública",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/publico/menu",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"publico",
								"menu"
							]
						},
						"description": "",
						"auth": {
							"type": "noauth"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const carta = pm.response.json();",
									"pm.test('200 con categorías y productos', () => {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(carta.categorias).to.be.an('array').that.is.not.empty;",
									"    pm.expect(carta.productos).to.be.an('array').that.is.not.empty;",
									"});",
									"pm.test('cada producto tiene nombre y precio válido', () => carta.productos.forEach(p => {",
									"    pm.expect(p.nombre).to.be.a('string').and.not.empty;",
									"    pm.expect(p.precio_venta).to.be.a('number').and.to.be.at.least(0);",
									"}));",
									"pm.test('CP-API-SEG · no expone el costo ni datos internos', () => carta.productos.forEach(p => {",
									"    pm.expect(p).to.not.have.any.keys('costo', 'tn_product_id', 'ingredientes_receta');",
									"}));",
									"const ensalada = carta.productos.find(p => p.id === Number(pm.collectionVariables.get('producto_id')));",
									"if (ensalada) pm.collectionVariables.set('producto_precio', ensalada.precio_venta);"
								]
							}
						}
					]
				},
