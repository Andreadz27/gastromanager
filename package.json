{
  "name": "morfi",
  "version": "1.0.0",
  "description": "Sistema de gestión gastronómica - POS, inventario, comandas, reportes y más.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "init-db": "node init-db.js",
    "test": "node --test --test-timeout=60000 \"test/*.test.js\"",
    "test:e2e": "node --test --test-timeout=300000 --test-concurrency=1 \"test/e2e/*.test.js\"",
    "test:todo": "npm test && npm run test:e2e",
    "demo": "node scripts/demo/iniciar-demo.js",
    "demo:video": "node scripts/demo/grabar-video.js",
    "demo:presentacion": "node scripts/demo/armar-presentacion.js",
    "demo:publica": "node scripts/demo/demo-publica.js",
    "usuario:prueba": "node scripts/crear-usuario-prueba.js",
    "lint": "eslint .",
    "check": "npm run lint && node scripts/verificar-nombres.js . && npm test",
    "prueba:fuego": "node scripts/prueba-de-fuego.js",
    "actualizar": "node scripts/actualizar.js",
    "restaurar": "node scripts/restaurar.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "restaurant",
    "pos",
    "gestion",
    "gastronomia",
    "sistema"
  ],
  "author": "Morfi",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "dependencies": {
    "@afipsdk/afip.js": "^1.2.3",
    "@fortawesome/fontawesome-free": "6.4.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "playwright-core": "^1.63.0"
  }
}
